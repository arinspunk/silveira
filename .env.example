# Copy to .env and adjust per machine if needed.
# Canonical URL (also in docker-compose.yml via WORDPRESS_CONFIG_EXTRA):
#   http://silveira.localhost  (port 80; no :8070 in the browser)
# /etc/hosts is usually not needed: *.localhost points to 127.0.0.1.
# The container publishes host port 80; if you already have another service on 80,
# change the `ports` mapping in docker-compose.yml (e.g. 8070:80) and the URL in WORDPRESS_CONFIG_EXTRA.

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
WORDPRESS_TABLE_PREFIX=wp_

# --- Vite (silveira theme): do NOT use WP_DEBUG for this. Local development only. ---
# With 1, the theme loads CSS/JS from the Vite server (HMR). With 0 or unset, it uses built assets.
# The browser stays on http://silveira.localhost; Vite usually runs on host port 5173.
SILVEIRA_VITE_DEV=0
# Vite server base URL as the BROWSER (not PHP) must load it. On the same machine: 127.0.0.1.
# host.docker.internal is for container→host traffic; it often does NOT work in <script src> from Chrome/Safari.
# Another device / Linux: use the IP:5173 shown by `npm run dev` (Network) or extra_hosts in Docker.
VITE_DEV_SERVER_URL=http://127.0.0.1:5173
